{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    { "source": "/analyzer", "destination": "/", "permanent": false },
    { "source": "/analyzer.html", "destination": "/", "permanent": false },
    { "source": "/workflow", "destination": "/", "permanent": false },
    { "source": "/workflow.html", "destination": "/", "permanent": false },
    { "source": "/about", "destination": "/", "permanent": false },
    { "source": "/about.html", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/login",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
